{
  "name": "omniplex-desktop",
  "productName": "Omniplex",
  "version": "0.0.0",
  "private": true,
  "description": "Omniplex desktop app: runs the Omniplex server and shows its UI.",
  "author": "Omniplex",
  "license": "MIT",
  "homepage": "https://github.com/asiraky/omniplex#readme",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "icons": "node scripts/icons.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:mac": "npm run dist -- --mac --arm64 --x64",
    "dist:win": "npm run dist -- --win --x64",
    "dist:linux": "npm run dist -- --linux --x64"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.5.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
